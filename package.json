    "art:action-avatar": "node tools/project/prepare-action-avatar.mjs",
    "qa:actions": "node tools/qa/action-visual.mjs",
    "test:actions": "node --test tests/action-rig.test.mjs",
    "art:pose-avatar": "node tools/project/prepare-pose-avatar.mjs",
    "test:poses": "node --test tests/pose-dissolve.test.mjs",
    "qa:poses": "node tools/qa/pose-visual.mjs",
    "qa:pose-options": "node tools/qa/pose-options.mjs",
    "qa:release-soak": "node tools/qa/release-soak.mjs",
    "qa:installer": "pwsh -NoProfile -File tools/qa/installer-check.ps1",
    "qa:agent-desktop": "node tools/qa/agent-desktop.mjs",
    "qa:local-speech": "node tools/qa/local-speech.mjs",
    "qa:data-copy": "node tools/qa/data-copy.mjs",
    "qa:prerequisites": "node tools/qa/prerequisites.mjs",
