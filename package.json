{
  "name": "vibe-voice",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "Windows 4K wallpaper companion for Codex with local voice",
  "repository": {
    "type": "git",
    "url": "https://github.com/code-lawyer/Rin-Desktop.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node tools/project/start.mjs",
    "start:avatar": "node tools/project/start.mjs --mode=avatar",
    "start:dots": "node tools/project/start.mjs --provider=dots",
    "status": "node tools/project/status.mjs",
    "remote:diagnose": "pwsh -NoProfile -File tools/remote-diagnostics/run.ps1",
    "check:public": "node tools/release/audit-public.mjs --worktree",
    "check:project": "node tools/project/check-project.mjs",
    "project:docs": "node tools/project/render-progress.mjs",
    "qa:known-issues": "node tools/qa/reproduce-known-issues.mjs",
    "qa:inventory": "node tools/qa/project-inventory.mjs",
    "qa:shutdown": "node tools/qa/shutdown-desktop.mjs",
    "qa:live2d-models": "node tools/qa/live2d-model-inspection.mjs",
    "qa:remote-component": "node tools/qa/remote-component.mjs",
    "qa:interface": "node tools/qa/interface-check.mjs",
    "qa:visual": "node tools/qa/visual-check.mjs",
    "qa:remote-focus": "node tools/qa/remote-focus.mjs",
    "qa:data-agent": "node tools/qa/data-agent.mjs",
    "data:recover": "node tools/qa/recover-data.mjs",
    "probe:claude": "node tools/probes/cli-agents/claude-probe.mjs",
    "probe:grok": "node tools/probes/cli-agents/acp-probe.mjs grok",
    "probe:opencode": "node tools/probes/cli-agents/acp-probe.mjs opencode",
    "test": "npm --prefix prototypes/live2d-codex test && node --test tests/*.test.mjs",
    "build": "npm --prefix prototypes/live2d-codex run build",
    "resources": "node tools/release/bootstrap-resources.mjs",
    "package": "node tools/release/build.mjs",
    "package:test": "node tools/release/test-build.mjs",
    "preview:halfbody": "node tools/project/preview-halfbody.mjs",
    "qa:halfbody": "node tools/qa/live2d-halfbody-preview.mjs",
    "qa:halfbody:diagnose": "node tools/qa/live2d-halfbody-diagnose.mjs",
    "qa:character-video": "node tools/qa/character-video-analysis.mjs",
    "test:character-video": "node --test tests/character-video-analysis.test.mjs",
    "test:video-desktop": "node --test prototypes/live2d-codex/tests/video-wallpaper.test.mjs",
    "test:video": "node --test tests/video-companion.test.mjs",
    "build:halfbody": "node tools/project/preview-halfbody.mjs --build",
    "test:halfbody": "node --test tests/live2d-halfbody.test.mjs",
    "qa:release-package": "node tools/qa/release-package.mjs",
    "preview:stills": "node tools/project/preview-stills.mjs",
    "preview:still-scene": "node tools/project/preview-stills.mjs --scene",
    "test:stills": "node --test tests/still-wallpaper.test.mjs tests/still-integration.test.mjs tests/still-renderer.test.mjs",
    "audio:prepare": "node tools/project/prepare-ambience.mjs",
    "art:stills-4k": "node tools/project/prepare-still-4k.mjs",
    "art:video-4k": "node tools/project/prepare-video-4k.mjs",
    "art:motion-clips": "node tools/project/prepare-motion-clips.mjs",
    "art:transition-demo": "node tools/project/compose-transition-demo.mjs",
    "art:idle-kit": "node tools/project/prepare-idle-loop-kit.mjs",
    "art:work-idle-demo": "node tools/project/compose-work-idle-demo.mjs",
    "preview:video-4k": "node tools/project/preview-video-4k.mjs",
    "preview:transitions": "node tools/project/preview-transitions.mjs",
    "test:transitions": "node --test tests/transition-preview.test.mjs",
    "qa:transitions": "node tools/qa/transition-media.mjs",
    "qa:transition-trim": "node tools/qa/transition-trim-analysis.mjs",
    "qa:idle-loop": "node tools/qa/idle-loop-media.mjs",
    "qa:video-seam": "node tools/qa/video-seam.mjs",
    "qa:stills": "node tools/qa/still-desktop.mjs",
    "test:motion": "node --test tests/motion-wallpaper.test.mjs",
    "qa:motion": "node tools/qa/motion-desktop.mjs",
    "qa:motion-live": "node tools/qa/motion-live.mjs",
    "qa:still-scene": "node tools/qa/still-scene.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
